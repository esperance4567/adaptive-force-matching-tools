#!/usr/bin/perl
#This routine sorts the atoms according to molecule label (mol).

if( @ARGV && ($ARGV[0] eq '-h' || $ARGV[0] eq '-help' || $ARGV[0] eq '--help'))
{
help();
exit;
}
sub help {
    print "\n=== pxyz_sort_mol - Molecule-Label Atom Sorting ===\n\n";
    print "PURPOSE:\n";
    print "  Sorts atoms by the letters of their molecule label (the 5th column), A to Z,\n";
    print "  ignoring upper/lower case.\n";
    print "  Groups atoms of the same molecule type together, regardless of the leading number.\n\n";
    print "USAGE:\n";
    print "  pxyz_sort_mol [file.pxyz]\n";
    print "  pxyz_sort_mol < system.pxyz > sorted.pxyz\n\n";
    print "PARAMETERS:\n";
    print "  file.pxyz   - Input .pxyz file (optional, reads from stdin if not provided)\n\n";
    print "INPUT:\n";
    print "  - .pxyz format file (via stdin or file argument)\n";
    print "  - Each atom line: index x y z mol mark\n";
    print "  - mol is a label of leading digits followed by letters (e.g. 12ABC)\n\n";
    print "OUTPUT:\n";
    print "  - Sorted .pxyz file written to stdout\n";
    print "  - Complete .pxyz format with preserved atom count and header line\n\n";
    print "DETAILS:\n";
    print "  - Primary sort: trailing letters of mol, compared alphabetically, A to Z,\n";
    print "    CASE-INSENSITIVELY (so ISOP, Isop and isop sort together)\n";
    print "    (the leading number is ignored at this stage)\n";
    print "  - Secondary sort: leading digits of mol, compared NUMERICALLY, ascending\n";
    print "    (only used when the letters are identical ignoring case, so 9A comes\n";
    print "    before 10A, and 9A and 10a are ordered by their numbers alone)\n";
    print "  - Tertiary sort: original file order, so atoms with identical labels\n";
    print "    keep their relative order and none are dropped\n";
    print "  - Preserves all atom information while reordering\n";
    print "  - Labels with no leading digits are treated as having digit value 0\n\n";
    print "EXAMPLES:\n";
    print "  pxyz_sort_mol system.pxyz > organized.pxyz            # Sort by mol label\n";
    print "  pxyz_dropoff 0 temp.pxyz | pxyz_sort_mol > final.pxyz # Clean and sort\n\n";
    print "TYPICAL WORKFLOW:\n";
    print "  Group atoms by molecule type before final processing:\n";
    print "  pxyz_dropoff 0 marked.pxyz | pxyz_sort_mol | pxyz_recenter 1 > final.pxyz\n\n";
    print "MOL ORDER EXAMPLE (first to last):\n";
    print "  2A < 9a < 12A < 2B < 9B < 12b < 10C\n\n";
}

$_=<>; print; chomp; $natm=$_;
$_=<>; print;

@atoms = ();

for ($i=0; $i<$natm; $i++)
{
    $line = <>;
    ($nam,$xxx,$yyy,$zzz,$mol,$val) = split ' ', $line;

    ($digits, $letters) = $mol =~ /^(\d+)(.*)$/;
    $digits  = 0  unless defined $digits;
    $letters = $mol unless defined $letters;

    push @atoms, [ $digits, $letters, $i, $line ];
}

foreach my $atom (sort { lc($a->[1]) cmp lc($b->[1])
                      or $a->[0]     <=> $b->[0]
                      or $a->[2]     <=> $b->[2] } @atoms)
{
    print $atom->[3];
}
